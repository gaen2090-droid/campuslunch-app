{
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/r/:linkNo",
      "destination": "/api/link?kind=restaurant&no=:linkNo"
    },
    {
      "source": "/coupons",
      "destination": "/api/link?kind=coupons"
    },
    {
      "source": "/home",
      "destination": "/api/link?kind=home"
    },
    {
      "source": "/invite",
      "destination": "/api/link?kind=invite"
    },
    {
      "source": "/restaurant/:id",
      "destination": "/api/restaurant?id=:id"
    }
  ]
}
